{
  "name": "@decktile/lezer-decktile",
  "version": "0.1.0",
  "description": "CodeMirror 6 language support for decktile Markdown slide decks (frontmatter, slides, @directives, ::: fences, pdg code blocks)",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "tsdown",
    "check": "biome check . && tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "decktile",
    "slides",
    "markdown",
    "lezer",
    "codemirror",
    "codemirror6",
    "syntax-highlighting"
  ],
  "author": "Reza Jelveh <fishmangit@dynamia.ai>",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@predictygraph/lezer-pdg": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/decktile/lezer-decktile#readme",
  "bugs": "https://github.com/decktile/lezer-decktile/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decktile/lezer-decktile.git"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
